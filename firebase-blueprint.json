{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role and status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "moderator", "member"] },
        "isSuspended": { "type": "boolean" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Resource": {
      "title": "Educational Resource",
      "description": "Educational resource item published by users",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "educationLevel": { "type": "string" },
        "mediaType": { "type": "string" },
        "link": { "type": "string" },
        "tags": { "type": "array" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "isHiddenByAdmin": { "type": "boolean" },
        "viewsCount": { "type": "number" },
        "favoritesCount": { "type": "number" },
        "reportCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "category", "authorId", "authorName"]
    },
    "Favorite": {
      "title": "Favorite Bookmark",
      "description": "User bookmarked resource",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceTitle": { "type": "string" },
        "resourceCategory": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "resourceId"]
    },
    "Report": {
      "title": "Content Report",
      "description": "Report of inappropriate content or broken links",
      "type": "object",
      "properties": {
        "resourceId": { "type": "string" },
        "resourceTitle": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["resourceId", "reporterId", "reason", "status"]
    },
    "ModerationLog": {
      "title": "Moderation Log",
      "description": "Audit trail of admin and moderator actions",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "targetType": { "type": "string" },
        "moderatorId": { "type": "string" },
        "moderatorEmail": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["action", "targetId", "moderatorId"]
    },
    "Setting": {
      "title": "Website Settings",
      "description": "Global website configuration and custom categories",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "siteDescription": { "type": "string" },
        "announcement": { "type": "string" },
        "isAnnouncementActive": { "type": "boolean" },
        "categories": { "type": "array" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["siteName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/Resource" },
      "description": "Educational knowledge resources"
    },
    "/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "User favorites mapping (composite key or generated ID)"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Content reports submitted by users"
    },
    "/moderationLogs/{logId}": {
      "schema": { "$ref": "#/entities/ModerationLog" },
      "description": "Audit logs for moderation actions"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Setting" },
      "description": "Site global configuration (document: 'general')"
    }
  }
}
